# Database Configuration
# PostgreSQL connection string
DATABASE_URL=postgresql://username:password@localhost:5432/hoagiang_manager
DATABASE_SSL_MODE=disable
# Optional PEM CA certificate. Escape line breaks as \\n when stored on one line.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----

# JWT Authentication
# Secret key for JWT tokens (minimum 32 characters, use a strong random string in production)
JWT_SECRET=your-secret-key-change-this-min-32-characters
JWT_EXPIRES_IN=24h
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
ALLOW_PUBLIC_REGISTRATION=false

# Password assigned to every new staff account. Choose a value that suits this internal system.
# This value is never returned by the API or shown in a toast.
DEFAULT_STAFF_PASSWORD=123456

# Required only when running npm run db:seed. Do not commit real values.
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# TEST_EMAIL=
# TEST_PASSWORD=

# Server Configuration
PORT=3000
NODE_ENV=development

# File Upload Configuration
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE=5242880

# Production-specific settings (uncomment and configure for production)
# NODE_ENV=production
# DATABASE_URL=postgresql://username:password@your-production-db-host:5432/hoagiang_manager
# DATABASE_SSL_MODE=verify-full
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\\n...\\n-----END CERTIFICATE-----
# JWT_SECRET=your-production-secret-key-min-32-characters
# UPLOAD_DIR=/var/www/uploads (or use cloud storage like S3)
